{
  "dependencies": {
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build:pages": "npm run build && mkdir -p .pages-output && cp index.html style.css .pages-output && cp -r dist .pages-output/dist",
    "build": "tsc",
    "dev": "concurrently -k -n tsc,server -c blue,green \"npm run watch\" \"live-server --port=5500 --watch=dist,index.html,style.css --ignore=node_modules,src,.idea\"",
    "watch": "tsc -w"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "live-server": "^1.2.2",
    "wrangler": "^4.140.0"
  }
}
